# Scribely configuration.
#
# Copy to config.toml and edit. Lookup order:
#   1. $SCRIBELY_CONFIG
#   2. ./config.toml (current working directory)
#   3. per-user config dir (macOS: ~/Library/Application Support/Scribely/config.toml,
#      Windows: %LOCALAPPDATA%\Scribely\config.toml)
# Any value can be overridden with an env var: SCRIBELY_<SECTION>__<KEY>, e.g. SCRIBELY_LLM__MODEL.
#
# API keys are never stored anywhere. Enter yours in the app's Settings panel each time
# Scribely starts (kept in memory only), or set them as environment variables:
#   azure_openai: AZURE_OPENAI_API_KEY    anthropic: ANTHROPIC_API_KEY
#   openai:       OPENAI_API_KEY          gemini:    GOOGLE_API_KEY
#   ollama:       none (local)
#
# The values below are the built-in defaults.

[server]
host = "127.0.0.1"   # keep on loopback: the sidecar is local-only
port = 8765
# Browser origins allowed to open the /ws WebSocket (Tauri webview + Vite dev server).
allowed_origins = ["tauri://localhost", "http://tauri.localhost", "https://tauri.localhost", "http://localhost:1420", "http://127.0.0.1:1420"]

[capture]
backend = "auto"            # auto | wasapi (Windows) | screencapturekit (macOS) | file
# file_path = "lecture.wav" # 16-bit PCM WAV streamed by the "file" backend (dev/testing)
file_realtime = true
max_queue_seconds = 120.0   # audio buffered for a slow consumer before the oldest is dropped

[stt]
# Models are downloaded once from Hugging Face into models_dir; audio never leaves the machine.
model = "small"             # tiny | base | small | medium | large-v3 | distil-large-v3 | HF repo id | local dir
device = "auto"             # auto | cpu | cuda
compute_type = "default"    # e.g. int8 (fast on CPU), float16 (GPU); default lets CTranslate2 choose
# language = "en"           # set it for best results; unset auto-detects per segment
beam_size = 5
vad_threshold = 0.5
min_silence_ms = 600        # pause that ends a transcript segment
speech_pad_ms = 200
max_segment_seconds = 15.0  # continuous speech is cut at the longest pause after this
partial_interval_seconds = 1.0   # live partial hypotheses while speaking; 0 disables

[llm]
# Used only when you press Summarize on a stopped session. Only the transcript text is sent.
# Settings saved from the app's Settings panel override these values.
provider = "azure_openai"   # azure_openai | anthropic | openai | gemini | ollama
model = "gpt-4o"            # for azure_openai, the model behind your deployment
temperature = 0.2
# context_window = 128000   # override the model's known context window (tokens)
# azure_endpoint = "https://<resource>.openai.azure.com/"   # or AZURE_OPENAI_ENDPOINT
# azure_deployment = "gpt-4o"
azure_api_version = "2024-10-21"
ollama_host = "http://localhost:11434"
max_output_tokens = 4096
request_timeout_seconds = 120.0

[pipeline]
chunk_size_tokens = 6000
chunk_overlap_tokens = 200
max_concurrency = 4         # transcript chunks summarized in parallel

[paths]
# data_dir = "~/Scribely"         # default: per-user data dir via platformdirs
# exports_dir = "~/Scribely/exports"
# models_dir = "~/Scribely/models"  # speech models; downloaded here on first use

[logging]
level = "INFO"       # DEBUG | INFO | WARNING | ERROR
format = "console"   # console | json
