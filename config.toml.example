# Scribely configuration.
#
# Copy to config.toml and edit. Lookup order:
#   1. $SCRIBELY_CONFIG
#   2. ./config.toml (current working directory)
#   3. per-user config dir (macOS: ~/Library/Application Support/Scribely/config.toml,
#      Windows: %LOCALAPPDATA%\Scribely\config.toml)
# Any value can be overridden with an env var: SCRIBELY_<SECTION>__<KEY>, e.g. SCRIBELY_LLM__MODEL.
#
# API keys never go in this file. Set them as environment variables:
#   azure_openai: AZURE_OPENAI_API_KEY    anthropic: ANTHROPIC_API_KEY
#   openai:       OPENAI_API_KEY          gemini:    GOOGLE_API_KEY
#   ollama:       none (local)
#
# The values below are the built-in defaults.

[server]
host = "127.0.0.1"   # keep on loopback: the sidecar is local-only
port = 8765

[capture]
backend = "auto"            # auto | wasapi (Windows) | screencapturekit (macOS) | file
# file_path = "lecture.wav" # 16-bit PCM WAV streamed by the "file" backend (dev/testing)
file_realtime = true
max_queue_seconds = 120.0   # audio buffered for a slow consumer before the oldest is dropped

[llm]
provider = "azure_openai"   # azure_openai | anthropic | openai | gemini | ollama
model = "gpt-4o"            # for azure_openai, the model behind your deployment
temperature = 0.2
# context_window = 128000   # override the model's known context window (tokens)
# azure_endpoint = "https://<resource>.openai.azure.com/"   # or AZURE_OPENAI_ENDPOINT
# azure_deployment = "gpt-4o"
azure_api_version = "2024-10-21"
ollama_host = "http://localhost:11434"

[pipeline]
chunk_size_tokens = 6000
chunk_overlap_tokens = 200

[paths]
# data_dir = "~/Scribely"         # default: per-user data dir via platformdirs
# exports_dir = "~/Scribely/exports"

[logging]
level = "INFO"       # DEBUG | INFO | WARNING | ERROR
format = "console"   # console | json
